# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/timemanagement"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth client (see README → "Google Cloud setup")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Needed when self-hosting / running `npm start` (Vercel sets this automatically)
AUTH_TRUST_HOST=true

# Optional: used by the user-isolation integration test (a throwaway database)
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/timemanagement_test"
